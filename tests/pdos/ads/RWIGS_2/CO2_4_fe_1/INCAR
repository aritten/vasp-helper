SYSTEM=EM-structure-relaxtation # Job description
ISTART   = 1             ! Wavefunction input setting (0 is fresh)
ICHARG   = 2             ! Charge density density input setting (2 is fresh)
IBRION   = -1
ENCUT    = 500           ! ALWAYS set the energy cutoff for each KPOINT to determine # of plane waves
PREC     = Accurate      ! Accurate precision for your grids, please do NOT change
ALGO     = N             ! Always use F (for fast!), highly-optimized black-box routine.
LASPH    = T             ! Add non-spherical corrections to the PAW sphere (cheap and increases acc.)
NELM     = 500            ! Max number of electronic steps in SCF cycle
NELMIN   = 6             ! Minimum number of SCF steps (set to ensure accurate forces)
ROPT     = 5*0.0005
LREAL    = A             ! Allow VASP to decide how projectors are evaluated (real vs reciporal space)
EDIFF    = 1.0E-4        ! Allowed energy diff. (dev rec) between SCF steps to call it cycle done (in eV)
ISMEAR   = 0
SIGMA    = 0.3
NUPDOWN  = 0
ISYM     = 2             ! Flag to set symmetry, 2 is turing on, 0 is off (except time reversal)
ISIF     = 2             ! How to optimize geometry, 2 is positions only (usualyl use this)
NSW      = 0
EDIFFG   = -0.03         ! Force criteria for all relaxed cart. coordinates in eV/A, ALWAYS NEGATIVE!
LDIPOL   = .TRUE.
IDIPOL = 3             ! Flag for dipole corrections along vectors
LWAVE    = T             ! Flag to set if WAVECAR gets written (KS states in binary...)
LCHARG   = .TRUE.             ! Flag to set if charge density (on real-space grid) gets written
LVTOT    = F             ! Flag to set if potential energy on real space grid is evaluated
LORBIT   = 0
NPAR     = 4             ! Number of bands treated in parallel
GGA      = RP
RWIGS    = 1.683 1.43 0.902 0.902 0.946
AMIX     = 0.2
BMIX     = 2.0
